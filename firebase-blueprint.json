{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized super-admin or admin identity record managed server-side",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["super_admin", "admin"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role"]
    },
    "User": {
      "title": "User",
      "description": "User profile, moderation status, stats, and wallet information",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "ign": { "type": "string", "maxLength": 50 },
        "gameIGNs": { "type": "object" },
        "gameUid": { "type": "string", "maxLength": 50 },
        "gameUIDs": { "type": "object" },
        "primaryGame": { "type": "string", "maxLength": 32 },
        "authProvider": { "type": "string", "maxLength": 32 },
        "profileCompleted": { "type": "boolean" },
        "avatar": { "type": "string", "maxLength": 2500 },
        "wallet": {
          "type": "object",
          "properties": {
            "deposit": { "type": "number" },
            "winnings": { "type": "number" },
            "bonus": { "type": "number" }
          }
        },
        "isKycVerified": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "isStaff": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "staff", "admin"] },
        "staffPermissions": {
          "type": "object",
          "properties": {
            "dashboard": { "type": "boolean" },
            "withdrawals": { "type": "boolean" },
            "notifications": { "type": "boolean" },
            "usersAndBlacklist": { "type": "boolean" },
            "matches": { "type": "boolean" },
            "transactions": { "type": "boolean" },
            "gameRules": { "type": "boolean" },
            "gameModes": { "type": "boolean" },
            "banners": { "type": "boolean" },
            "referralAndSupport": { "type": "boolean" },
            "paymentGateways": { "type": "boolean" }
          }
        },
        "staffUpdatedAt": { "type": "string", "format": "date-time" },
        "staffUpdatedBy": { "type": "string", "maxLength": 200 },
        "permissions": { "type": "object" },
        "isBanned": { "type": "boolean" },
        "isDeviceBanned": { "type": "boolean" },
        "banReason": { "type": "string", "maxLength": 500 },
        "bannedAt": { "type": "string", "format": "date-time" },
        "stats": {
          "type": "object",
          "properties": {
            "matchesPlayed": { "type": "number" },
            "totalWins": { "type": "number" },
            "totalKills": { "type": "number" },
            "totalWinnings": { "type": "number" },
            "totalDeposited": { "type": "number" }
          }
        },
        "referralCode": { "type": "string", "maxLength": 32 },
        "referredBy": { "type": "string", "maxLength": 100 },
        "referralClaimed": { "type": "boolean" },
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceFingerprint": { "type": "string", "maxLength": 256 },
        "deviceInfo": { "type": "string", "maxLength": 256 },
        "fcmEnabled": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "wallet"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "referral": {
          "type": "object",
          "properties": {
            "baseUrl": { "type": "string" },
            "perReferralReward": { "type": "number" },
            "rewardType": { "type": "string", "enum": ["deposit", "bonus", "both"] },
            "depositPercentage": { "type": "number" },
            "bonusPercentage": { "type": "number" },
            "newUserReward": { "type": "number" }
          }
        },
        "support": {
          "type": "object",
          "properties": {
            "whatsapp": { "type": "string" },
            "telegram": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "policies": { "type": "object" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["deposit", "withdraw", "withdrawal", "win", "entry", "refund", "bonus"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "pending", "failed", "rejected", "abandoned"] },
        "matchId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 250 },
        "gateway": { "type": "string", "maxLength": 64 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "utr": { "type": "string", "maxLength": 128 },
        "adminNote": { "type": "string", "maxLength": 500 },
        "rejectedReason": { "type": "string", "maxLength": 500 },
        "referenceId": { "type": "string", "maxLength": 128 },
        "payoutMethod": { "type": "string", "maxLength": 32 },
        "payoutDetails": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "status", "createdAt"]
    },
    "Game": {
      "title": "Game",
      "description": "Game category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 2500 },
        "players": { "type": "number" }
      },
      "required": ["title", "image"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Match or tournament instance",
      "type": "object",
      "properties": {
        "gameId": { "type": "string", "maxLength": 50 },
        "modeId": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "image": { "type": "string", "maxLength": 2500 },
        "entryFee": { "type": "number" },
        "prize": { "type": "string", "maxLength": 100 },
        "prizePool": { "type": "number" },
        "perKillAmount": { "type": "number" },
        "prizeType": { "type": "string", "enum": ["perKill", "survival"] },
        "time": { "type": "string", "maxLength": 100 },
        "totalSlots": { "type": "number" },
        "maxPlayers": { "type": "number" },
        "playersCount": { "type": "number" },
        "players": { "type": "array" },
        "map": { "type": "string", "maxLength": 100 },
        "mode": { "type": "string", "maxLength": 50 },
        "section": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "completed", "cancelled"] },
        "cancelReason": { "type": "string", "maxLength": 500 },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "cancelledBy": { "type": "string", "maxLength": 200 },
        "matchNumber": { "type": "number" },
        "displayId": { "type": "string", "maxLength": 50 },
        "roomId": { "type": "string", "maxLength": 100 },
        "roomPass": { "type": "string", "maxLength": 100 }
      },
      "required": ["gameId", "title", "entryFee", "totalSlots"]
    },
    "Registration": {
      "title": "Registration",
      "description": "A user's registration for a specific tournament",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "ign": { "type": "string", "maxLength": 50 },
        "gameUid": { "type": "string", "maxLength": 50 },
        "slots": { "type": "array" },
        "teamMembers": { "type": "array" },
        "totalSlotsBooked": { "type": "number" },
        "gameId": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 32 },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tournamentId", "userId", "ign", "slots"]
    },
    "GameRule": {
      "title": "Game Rule",
      "description": "Rules for different game types",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "section": { "type": "string", "maxLength": 100 },
        "rules": {
          "type": "array"
        }
      },
      "required": ["rules"]
    },
    "GameMode": {
      "title": "Game Mode",
      "description": "Dynamic game mode configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "gameId": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 150 },
        "image": { "type": "string", "maxLength": 2500 },
        "category": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" }
      },
      "required": ["id", "gameId", "title", "image"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional home and offer banner",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "image": { "type": "string", "maxLength": 5000 },
        "imageUrl": { "type": "string", "maxLength": 5000 },
        "redirectUrl": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      }
    },
    "MatchResult": {
      "title": "Match Result",
      "description": "Declared winners and kill scores for a match",
      "type": "object",
      "properties": {
        "matchId": { "type": "string", "maxLength": 128 },
        "matchTitle": { "type": "string", "maxLength": 200 },
        "results": { "type": "array" },
        "declaredBy": { "type": "string", "maxLength": 200 },
        "declaredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["matchId", "results"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Broadcast, match, or user-specific in-app notification",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 1000 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "audience": { "type": "string", "enum": ["all", "match", "user"] },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "targetMatchId": { "type": "string", "maxLength": 128 },
        "actionPage": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 5000 },
        "readBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title"]
    },
    "PaymentGateway": {
      "title": "Payment Gateway",
      "description": "Configuration for a single payment gateway",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "apiKey": { "type": "string", "maxLength": 500 },
        "secretKey": { "type": "string", "maxLength": 500 },
        "merchantId": { "type": "string", "maxLength": 200 },
        "webhookSecret": { "type": "string", "maxLength": 500 },
        "upiId": { "type": "string", "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "isProduction": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isActive"]
    },
    "BlacklistedDevice": {
      "title": "Blacklisted Device",
      "description": "Hardware ban record for anti-cheat and fairplay enforcement",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceFingerprint": { "type": "string", "maxLength": 256 },
        "deviceInfo": { "type": "string", "maxLength": 256 },
        "bannedUserId": { "type": "string", "maxLength": 128 },
        "bannedUserEmail": { "type": "string", "maxLength": 200 },
        "bannedUsername": { "type": "string", "maxLength": 100 },
        "bannedUserIgn": { "type": "string", "maxLength": 100 },
        "reason": { "type": "string", "maxLength": 500 },
        "bannedBy": { "type": "string", "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "bannedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "reason", "isActive"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Server-managed admin roster"
    },
    "/blacklistedDevices/{deviceId}": {
      "schema": "BlacklistedDevice",
      "description": "Blacklisted hardware devices banned from accessing the app"
    },
    "/paymentSettings/{gatewayId}": {
      "schema": "PaymentGateway",
      "description": "Configurations for payment gateways (admin/payment staff only)"
    },
    "/gameModes/{modeId}": {
      "schema": "GameMode",
      "description": "Dynamic game mode configurations"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles, moderation flags, and wallet balances"
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Supported game categories"
    },
    "/matches/{matchId}": {
      "schema": "Tournament",
      "description": "Active tournament/match instances"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Legacy tournament mirror collection"
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Player match entries"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transaction audit trail"
    },
    "/matchResults/{matchId}": {
      "schema": "MatchResult",
      "description": "Declared match winners and scores"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "In-app and push notifications"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Promotional banners"
    },
    "/meta/counters": {
      "schema": "object",
      "description": "System-wide counters"
    },
    "/gameRules/{ruleId}": {
      "schema": "GameRule",
      "description": "Rules for various match types"
    },
    "/appSettings/{settingId}": {
      "schema": "AppSettings",
      "description": "Global application configuration"
    }
  }
}
